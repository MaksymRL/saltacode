// Schema Prisma per Saltacode Queue Manager
// Database: PostgreSQL 15

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Area {
  id         Int         @id @default(autoincrement())
  nome       String      @db.VarChar(100)
  prefisso   String      @unique @db.Char(2)
  attiva     Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  servizi    Servizio[]
  utentiAree UtenteArea[]

  @@map("aree")
}

model Ruolo {
  id          Int          @id @default(autoincrement())
  nome        String       @unique // SUPERADMIN, ADMIN, ACCOGLIENZA, OPERATORE
  utentiRuoli UtenteRuolo[]

  @@map("ruoli")
}

model Utente {
  id               Int                 @id @default(autoincrement())
  username         String              @unique @db.VarChar(53)
  cognome          String              @db.VarChar(50)
  nome             String              @db.VarChar(50)
  passwordHash     String
  stato            String              @default("ATTIVO") // ATTIVO, PAUSA, DISABILITATO
  mustChangePwd    Boolean             @default(true)
  createdAt        DateTime            @default(now())
  utentiAree       UtenteArea[]
  utentiRuoli      UtenteRuolo[]
  operatoriServizi OperatoreServizio[]
  chiamate         Chiamata[]

  @@map("utenti")
}

/// Tabella di join tra Utente e Ruolo (many-to-many).
/// Un utente può avere più ruoli (es. ADMIN + OPERATORE).
model UtenteRuolo {
  id       Int    @id @default(autoincrement())
  utenteId Int
  ruoloId  Int
  utente   Utente @relation(fields: [utenteId], references: [id], onDelete: Cascade)
  ruolo    Ruolo  @relation(fields: [ruoloId], references: [id])

  @@unique([utenteId, ruoloId])
  @@map("utenti_ruoli")
}

model UtenteArea {
  id       Int    @id @default(autoincrement())
  utenteId Int
  areaId   Int
  utente   Utente @relation(fields: [utenteId], references: [id], onDelete: Cascade)
  area     Area   @relation(fields: [areaId], references: [id])

  @@unique([utenteId, areaId])
  @@map("utenti_aree")
}

model Servizio {
  id               Int                     @id @default(autoincrement())
  areaId           Int
  area             Area                    @relation(fields: [areaId], references: [id])
  nome             String                  @db.VarChar(100)
  lettera          String                  @db.Char(1)
  attivo           Boolean                 @default(true)
  createdAt        DateTime                @default(now())
  operatoriServizi OperatoreServizio[]
  contatori        ContatoreGiornaliero[]
  ticket           Ticket[]
  chiamate         Chiamata[]

  @@unique([areaId, lettera])
  @@map("servizi")
}

model OperatoreServizio {
  id         Int      @id @default(autoincrement())
  utenteId   Int
  servizioId Int
  utente     Utente   @relation(fields: [utenteId], references: [id])
  servizio   Servizio @relation(fields: [servizioId], references: [id])

  @@unique([utenteId, servizioId])
  @@map("operatori_servizi")
}

model ContatoreGiornaliero {
  id           Int      @id @default(autoincrement())
  servizioId   Int
  servizio     Servizio @relation(fields: [servizioId], references: [id])
  ultimoNumero Int      @default(0)
  data         DateTime @db.Date

  @@unique([servizioId, data])
  @@map("contatore_giornaliero")
}

model Ticket {
  id         Int        @id @default(autoincrement())
  servizioId Int
  servizio   Servizio   @relation(fields: [servizioId], references: [id])
  numero     String     @db.VarChar(6) // es. CAA001
  emessoPer  DateTime   @default(now())
  stato      String     @default("ATTESA") // ATTESA, CHIAMATO, SERVITO
  chiamate   Chiamata[]

  @@unique([servizioId, numero, emessoPer])
  @@map("ticket")
}

model Chiamata {
  id         Int      @id @default(autoincrement())
  utenteId   Int
  servizioId Int
  utente     Utente   @relation(fields: [utenteId], references: [id])
  servizio   Servizio @relation(fields: [servizioId], references: [id])
  ticketId   Int?
  ticket     Ticket?  @relation(fields: [ticketId], references: [id])
  postazione String   @db.VarChar(3)
  timestamp  DateTime @default(now())

  @@map("chiamate")
}
